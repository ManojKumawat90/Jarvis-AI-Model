# Copy this file to .env and fill in your values.
# JARVIS will use macOS `say -v Daniel` as fallback if ELEVENLABS_API_KEY is not set.

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Claude model for JARVIS's brain (haiku = fastest, sonnet/opus = smartest).
# Leave unset to use your Claude Code default.
# JARVIS_MODEL=haiku
